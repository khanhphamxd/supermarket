type Product {
    id: ID!
    name: String!
    description: String!
    category: String!
    price: Float!
}

type InventoryItem {
    id: ID!
    product: Product!
    quantity: Int!
}

type Cart {
    id: ID!
    createdAt: String!
    items: [CartItem!]!
}

type CartItem {
    id: ID!
    product: Product!
    quantity: Int!
}

type Query {
    products(limit: Int): [Product!]!
    product(id: ID!): Product

    inventoryItems: [InventoryItem!]!
    inventoryItem(id: ID!): InventoryItem

    carts: [Cart!]!
    cart(id: ID!): Cart
}


type Mutation {
    createProduct(
        name: String!
        description: String!
        category: String!
        price: Float!
    ): Product!

    updateProduct(
        id: ID!
        name: String
        description: String
        category: String
        price: Float
    ): Product!

    deleteProduct(id: ID!): Boolean!

    createInventoryItem(productId: ID!, quantity: Int!): InventoryItem!
    updateInventoryItem(id: ID!, quantity: Int): InventoryItem!
    deleteInventoryItem(id: ID!): Boolean!

    createCart: Cart!
    deleteCart(id: ID!): Boolean!

    createCartItem(
        cartId: ID!
        productId: ID!
        quantity: Int!
    ): CartItem!

    updateCartItem(
        cartId: ID!
        itemId: ID!
        quantity: Int
    ): CartItem!

    deleteCartItem(cartId: ID!, itemId: ID!): Boolean!
}

